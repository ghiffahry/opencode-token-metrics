#!/usr/bin/env py
# -*- coding: utf-8 -*-
"""Pre-commit hook: syntax-check Python sources.

Installed via `git config core.hooksPath tools/git-hooks` so it is tracked
in version control. Aborts the commit on syntax errors.
"""

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent.parent
SERVER_PY = ROOT / "server.py"
TOOLS_GLOB = sorted((ROOT / "tools").glob("*.py"))


def main():
    targets = [str(SERVER_PY)] + [str(p) for p in TOOLS_GLOB]
    if not (SERVER_PY.exists() and targets):
        print("pre-commit: no Python sources to check")
        return 0

    r = subprocess.run([sys.executable, "-m", "py_compile"] + targets,
                       capture_output=True, text=True)
    if r.returncode != 0:
        print("pre-commit: Python syntax check FAILED")
        print(r.stderr or r.stdout)
        return 1
    print("pre-commit: Python syntax OK")
    return 0


if __name__ == "__main__":
    sys.exit(main())
